{
  "name": "streamlol-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Electron shell for the Streamlol Shelves web build",
  "license": "GPL-2.0-only",
  "author": "Streamlol",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir --config.win.signAndEditExecutable=false && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-icon.ps1",
    "dist": "npm run pack"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.streamlol.desktop",
    "productName": "Streamlol",
    "copyright": "Copyright © Streamlol contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/build",
        "to": "web-build"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
