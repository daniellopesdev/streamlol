{
  "name": "streamlol",
  "version": "0.2.0",
  "private": true,
  "description": "Stremio Shelves: personal library addon + stremio-web fork with a Shelves tab",
  "license": "GPL-2.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "addon": "npm --prefix addon start",
    "addon:test": "npm --prefix addon test",
    "web": "npx --yes pnpm@11.8.0 --dir web start",
    "web:build": "npx --yes pnpm@11.8.0 --dir web run build",
    "desktop": "npm --prefix desktop start",
    "desktop:pack": "npm --prefix desktop run pack",
    "test": "npm --prefix addon test"
  }
}
